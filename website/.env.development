# Local development points at the API running on your machine:
#
#   cd server
#   DATABASE_URL=... JWT_SECRET=... ANTHROPIC_API_KEY=... npm start
#
# Production sets this in render.yaml. Nothing secret belongs in this file —
# it is committed, and Vite bakes every VITE_* value into the browser bundle.
VITE_API_URL=http://localhost:3001
